# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it contains secrets.

# --- Flask runtime ---
FLASK_ENV=development
FLASK_DEBUG=False
APP_PORT=8000
VITE_API_BASE_URL=/api

# --- Secrets ---
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-dev-secret-string

# --- PostgreSQL ---
POSTGRES_HOST=global_postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=ChangeThisStrongPassword123!
SUPER_ADMIN_DATABASE_URL=postgresql://admin:ChangeThisStrongPassword123!@global_postgres:5432/sms_dev

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dev-sms.klopterz.in
# Server-side role permission checks: off | log | enforce (backend/app/utils/role_permissions.py)
PERMISSION_ENFORCEMENT=off

# --- Homework / AI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_URL=https://<your-project>.services.ai.azure.com/openai/v1/responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-90b-vision-instruct
CLOUDFLARE_API_URL=
AI_PROVIDER_ORDER=azure,groq,gemini,cloudflare
HOMEWORK_UPLOAD_DIR=/app/uploads/homework

# --- Push notifications (installed app / browser) ---
# Generate once per environment with: python backend/generate_vapid_keys.py  (never commit real keys;
# keep them unchanged afterwards or every device has to turn notifications on again). Empty = notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://dev-sms.klopterz.in

# --- Frontend build (private npm support) ---
NPM_REGISTRY=https://registry.npmjs.org
NPM_TOKEN=
