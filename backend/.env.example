# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it contains secrets.

# --- Flask runtime ---
FLASK_ENV=development                # development | production | testing
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Secrets ---
# In production, the app will refuse to start if these are missing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SUPER_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skool_main

# --- CORS ---
# Comma-separated list of allowed origins. Use specific domains in production.
CORS_ORIGINS=*
GEMINI_API_KEY=
HOMEWORK_UPLOAD_DIR=uploads/homework

# Set to 'true' when behind a trusted reverse proxy (nginx, Cloudflare, etc.)
TRUSTED_PROXY=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
