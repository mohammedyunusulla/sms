# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it contains secrets.

# --- Flask runtime ---
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Secrets ---
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SUPER_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms_dev

# --- CORS ---
CORS_ORIGINS=*
# Server-side role permission checks: off | log | enforce (backend/app/utils/role_permissions.py)
PERMISSION_ENFORCEMENT=off

# --- Homework / AI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_URL=https://<your-project>.services.ai.azure.com/openai/v1/responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-90b-vision-instruct
CLOUDFLARE_API_URL=
AI_PROVIDER_ORDER=azure,groq,gemini,cloudflare
HOMEWORK_UPLOAD_DIR=uploads/homework

# Set to 'true' when behind a trusted reverse proxy (nginx, Cloudflare, etc.)
TRUSTED_PROXY=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
